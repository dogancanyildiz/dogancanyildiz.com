{
  "name": "dogancanyildiz.com",
  "version": "0.14.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "predev": "velite --clean --strict",
    "dev": "node scripts/dev.mjs",
    "build": "velite --clean --strict && next build",
    "build:content": "velite --clean --strict",
    "build:app": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "verify:routes": "node scripts/assert-static-routes.mjs",
    "indexnow": "node scripts/indexnow-ping.mjs",
    "verify:links": "node scripts/audit-live-links.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "release:check": "node scripts/release-version.mjs --dry-run",
    "vendor:fonts": "node scripts/vendor-fonts.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "sharp": "^0.35.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.16",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "simple-icons": "^16.34.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@shikijs/rehype": "^4.5.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "velite": "0.4.0",
    "vitest": "^5.0.0"
  }
