{
  "name": "portfolio",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "predev": "velite --clean --strict",
    "dev": "node scripts/dev.mjs",
    "build": "velite --clean --strict && next build",
    "build:content": "velite --clean --strict",
    "build:app": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "verify:routes": "node scripts/assert-static-routes.mjs",
    "verify:links": "node scripts/audit-live-links.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "release:check": "node scripts/release-version.mjs --dry-run",
    "vendor:fonts": "node scripts/vendor-fonts.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-intl": "4.14.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "simple-icons": "^16.29.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@shikijs/rehype": "^4.4.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "velite": "0.4.0",
    "vitest": "^4.1.11"
  }
}
