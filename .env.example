# Coolify layer: Build
# Required. next build fails if it is missing, robots.ts and sitemap.ts read it.
# Canonical host is www (decision 2026-09-02); the apex redirects to it at the
# Cloudflare edge, so this value must stay the www origin.
NEXT_PUBLIC_SITE_URL=https://www.dogancanyildiz.com

# Coolify layer: Build
# Optional. The commit built and its build timestamp, shown in the footer
# (src/lib/build-info.ts). Coolify sets these from its own commit metadata;
# CI passes github.sha and the commit timestamp. Left empty, the build still
# succeeds, the footer just shows nothing for them.
NEXT_PUBLIC_BUILD_SHA=
NEXT_PUBLIC_BUILD_DATE=

# Coolify layer: Runtime only
# SMTP submission against the owner's Mailcow server (decision 2026-08-31,
# Resend removed). Use a dedicated mailbox app password, never the account
# password; the values stay out of the repository.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=contact@dogancanyildiz.com
SMTP_PASSWORD=

# Coolify layer: Runtime only
# Inbox that receives contact form messages. Required in production.
CONTACT_EMAIL=me@dogancanyildiz.com

# Coolify layer: Runtime only
# Sender address on the Mailcow server (DKIM and SPF live there). Required in
# production; outside production a dev fallback address is used.
FROM_EMAIL=contact@dogancanyildiz.com

# Coolify layer: Runtime only
# Set to "true" only once the origin accepts connections from Cloudflare alone
# (host firewall or Traefik ipAllowList) and Traefik trusts the Cloudflare
# ranges through forwardedHeaders.trustedIPs, see
# docs/deploy/traefik-ve-origin.md sections 2 and 5. trustedIPs on its own
# does not protect CF-Connecting-IP, any peer can set that header. Until then
# the rate limiter keys on the last x-forwarded-for entry, the hop appended by
# Traefik, which behind Cloudflare is an edge address: coarse, but not
# forgeable. Local development and PR previews stay on "false" because neither
# sits behind Cloudflare. The Cloudflare rate limiting rule on /api/contact
# remains the outer layer.
TRUST_CF_CONNECTING_IP=false

# Coolify layer: Build
# Public Uptime Kuma status page the Systems panel links to. Build time,
# optional: the link row is hidden when unset, and only https is accepted.
NEXT_PUBLIC_STATUS_URL=

# Coolify layer: Build
# Central self-hosted Umami on the owner's infra domain (2026-08-30 decision);
# this site is registered there as a website. Public values, but the layout is
# prerendered so they must be present at build time. The tag only ships in a
# production build and loads without asking for consent (2026-09-03 decision:
# Umami sets no cookie and stores no IP address).
UMAMI_SCRIPT_URL=https://umami.dravcore.com
UMAMI_WEBSITE_ID=

# Coolify layer: Build (temporary measurement window only)
# Set to 1 for one deploy to ship the strict Content-Security-Policy-Report-Only
# header (no 'unsafe-inline'). Read the csp-violation log lines for an hour or
# two, then remove the variable and redeploy. Leaving it on costs every visitor
# a burst of report POSTs per page view. See src/app/api/csp-report/mode.ts.
CSP_REPORT_ONLY=
