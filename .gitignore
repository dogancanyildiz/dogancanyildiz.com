# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*

# Yarn Berry
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js ─────────────────────────────────────────────────────────────────
/.next/
/out/
/build

# ─── Environment variables ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Testing & Coverage ──────────────────────────────────────────────────────
/coverage
/.nyc_output

# ─── Debug logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── OS & Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/settings.json
*.swp
*.swo

# ─── Deploy platforms ────────────────────────────────────────────────────────
.vercel
.netlify

# ─── Claude Code ─────────────────────────────────────────────────────────────
.claude/worktrees/
.claude/settings.local.json

# ─── Local-only files (content drafts, CV, private notes) ────────────────────
.local/

# ─── Audit ───────────────────────────────────────────────────────────────────
audit/

# ─── Nodeterm canvas state ───────────────────────────────────────────────────
.nodeterm/

# ─── AI Tools ────────────────────────────────────────────────────────────────
.claude/
.cursor/
.cursorrules

# ─── Next.js agent rules (rewritten by `next dev` on every start) ─────────────
AGENTS.md
CLAUDE.md

# ─── Velite content pipeline output ──────────────────────────────────────────
/.velite/
/public/static/
tests/fixtures/.velite-valid/
tests/fixtures/.velite-invalid/
# velite compiles a config file into <config dir>/node_modules/, so the test
# fixture configs under tests/fixtures leave this behind
tests/fixtures/node_modules/

# ─── Local audit registers (open items, private working notes) ───────────────
/audit/
