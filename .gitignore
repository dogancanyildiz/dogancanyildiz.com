# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*

# Yarn Berry
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js ─────────────────────────────────────────────────────────────────
/.next/
/out/
/build

# ─── Environment variables ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Testing & Coverage ──────────────────────────────────────────────────────
/coverage
/.nyc_output

# ─── Debug logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── OS & Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/settings.json
*.swp
*.swo

# ─── Deploy platforms ────────────────────────────────────────────────────────
.vercel
.netlify

# ─── Local-only files (content drafts, CV, private notes) ────────────────────
.local/

# ─── Nodeterm canvas state ───────────────────────────────────────────────────
.nodeterm/

# ─── AI Tools ────────────────────────────────────────────────────────────────
# Per machine state only. Anything a cloud agent needs from a fresh clone
# (CLAUDE.md, AGENTS.md, docs/) is tracked; see the 2026-09-08 change.
.claude/worktrees/
.claude/settings.local.json
.claude/*.local.*
# .cursor/ (plugin toggles, rules) travels between machines; the superpowers
# SDD workspace self-ignores by design and stays local.
.superpowers/

# ─── Session scratch ─────────────────────────────────────────────────────────
# Snapshots of the live site pulled during verification, never source.
/live/

# ─── Velite content pipeline output ──────────────────────────────────────────
/.velite/
/public/static/
tests/fixtures/.velite-invalid/
tests/fixtures/.velite-invalid-links/
tests/fixtures/.velite-schema-fields/
tests/fixtures/.velite-duplicate-key/
# velite compiles a config file into <config dir>/node_modules/, so the test
# fixture configs under tests/fixtures leave this behind
tests/fixtures/node_modules/

# ─── Local audit registers (open items, private working notes) ───────────────
# Owner's decision (2026-09-08): stays local; docs/11-acik-isler.md is the
# tracked list of open work.
/audit/
