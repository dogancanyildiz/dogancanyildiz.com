# Dependencies and build output, always reinstalled or regenerated in the image
node_modules
.next
out
coverage

# Version control and CI metadata
.git
.gitignore
.github

# Local only. .local holds the real portfolio content draft and the CV PDF,
# .nodeterm holds canvas state, .superpowers holds agent scratch files, audit
# holds the private working audit register, .cursor holds editor state.
# None of them belongs in an image layer.
.local
.nodeterm
.superpowers
audit
.cursor
.claude
.vscode
.idea

# Secrets. Runtime values are injected by Coolify, never baked into the image.
.env
.env.*

# Docs and root level markdown. This pattern is root only on purpose:
# a recursive **/*.md would also drop content/**/*.md, which Velite needs
# in Faz 4.
docs
*.md
!README.md
LICENSE

# Local verification helper, Coolify builds straight from the Dockerfile
docker-compose.yml

# TypeScript incremental build cache
tsconfig.tsbuildinfo
*.tsbuildinfo

# OS noise
.DS_Store
Thumbs.db

# Velite content pipeline output. Regenerated by "npm run build" inside the
# image (the "build" script runs velite before next build), so shipping a
# host-built copy here would only go stale.
.velite
public/static

# Velite's alternate output directories used by the test fixtures
# (tests/fixtures/.velite-invalid and friends). The "**/" prefix is load
# bearing: a slash free pattern is matched against the whole relative path
# with Go's filepath.Match, so a bare ".velite-*" would only ever hit a root
# level directory and none of these live at the root. Verified against a real
# "docker build" over a throwaway context.
**/.velite-*

# A test fixture that vendors its own node_modules (isolated module
# resolution cases) is still just test fixtures: never needed to build or run
# the production image. Same root only rule as above, hence the explicit path
# rather than relying on the "node_modules" line at the top of this file.
tests/fixtures/node_modules

# Side service compose stacks (Gatus, Umami). Deployed as separate Coolify resources.
infra
